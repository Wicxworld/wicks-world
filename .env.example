# Public site URL used for canonical links, sitemap, robots, and Open Graph.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When both CONTACT_EMAIL and RESEND_API_KEY are set, contact
# form submissions are also emailed. If either is missing, leads are still
# saved locally and the form reports success without claiming email was sent.
CONTACT_EMAIL=
RESEND_API_KEY=

# Optional. Set to "true" to load @vercel/analytics on the site.
NEXT_PUBLIC_VERCEL_ANALYTICS=
